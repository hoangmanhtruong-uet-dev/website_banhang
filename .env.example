# Copy file này thành .env và điền thông tin của bạn

# ============================
# DATABASE (MySQL)
# ============================
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/website_banhang"

# ============================
# AUTHENTICATION
# ============================
# Tạo bằng lệnh: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_ACCESS_SECRET="your-access-token-secret-key"
JWT_REFRESH_SECRET="your-refresh-token-secret-key"
JWT_ACCESS_TTL_MINUTES="15"
JWT_REFRESH_TTL_DAYS="7"

# ============================
# RATE LIMIT
# ============================
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_ATTEMPTS="5"

# ============================
# STORAGE
# ============================
STORAGE_PROVIDER="local"
UPLOAD_DIR="public/uploads"
UPLOAD_MAX_SIZE_MB="5"

# ============================
# APP CONFIG
# ============================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================
# CLOUDINARY (Upload ảnh)
# ============================
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ============================
# IDEMPOTENCY / WEBHOOKS
# ============================
IDEMPOTENCY_RETENTION_HOURS="72"
PAYMENT_IDEMPOTENCY_RETENTION_HOURS="168"
REFUND_IDEMPOTENCY_RETENTION_HOURS="720"
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET="replace-with-at-least-32-random-characters"
WEBHOOK_TOLERANCE_SECONDS="300"