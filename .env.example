# Copy file này thành .env và điền thông tin của bạn

# ============================
# DATABASE (MySQL)
# ============================
DATABASE_URL="mysql://USER:YOUR_DATABASE_PASSWORD@localhost:3306/website_banhang_dev"
# Dedicated disposable DB only; integration runner refuses names not ending with _test.
TEST_DATABASE_URL="mysql://USER:YOUR_DATABASE_PASSWORD@localhost:3306/website_banhang_test"

# ============================
# AUTHENTICATION
# ============================
# Tạo bằng lệnh: openssl rand -base64 32
JWT_SECRET="YOUR_LEGACY_JWT_SECRET_IF_REQUIRED"
JWT_ACCESS_SECRET="YOUR_ACCESS_TOKEN_SECRET_AT_LEAST_32_CHARS"
JWT_REFRESH_SECRET="YOUR_REFRESH_TOKEN_SECRET_AT_LEAST_32_CHARS"
ACCESS_TOKEN_TTL="15m"
# Positive integer seconds; required in production.
REFRESH_TOKEN_TTL="604800"

# ============================
# RATE LIMIT
# ============================
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_ATTEMPTS="5"
TRUST_PROXY="false"
RATE_LIMIT_TRUST_PROXY_HOPS="1"

# ============================
# STORAGE
# ============================
# Development-only default. For production, set STORAGE_PROVIDER="cloudinary".
# "s3" is not implemented and is rejected in production.
# "local" writes to UPLOAD_DIR; NOT suitable for production (ephemeral/non-durable).
STORAGE_PROVIDER="local"
UPLOAD_DIR="public/uploads"
MAX_FILE_SIZE="5242880"
UPLOAD_MAX_FILES_PER_REQUEST="5"
UPLOAD_DAILY_FILE_LIMIT="50"
UPLOAD_DAILY_BYTE_LIMIT="52428800"
UPLOAD_REQUEST_LIMIT="5"

# ============================
# APP CONFIG
# ============================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Exact, comma-separated browser origins allowed to mutate /api.
# Required in production unless NEXT_PUBLIC_APP_URL is explicitly configured.
API_ALLOWED_ORIGINS="http://localhost:3000"
# TRUST_PROXY=true also trusts proxy-supplied host/proto; the proxy must sanitize those headers.

# ============================
# CLOUDINARY (Required for production storage)
# ============================
CLOUDINARY_CLOUD_NAME="YOUR_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="YOUR_CLOUDINARY_API_SECRET"
CLOUDINARY_FOLDER="mtruong-store"

# ============================
# IDEMPOTENCY / WEBHOOKS
# ============================
IDEMPOTENCY_RETENTION_HOURS="72"
PAYMENT_IDEMPOTENCY_RETENTION_HOURS="168"
REFUND_IDEMPOTENCY_RETENTION_HOURS="720"
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET="replace-with-at-least-32-random-characters"
WEBHOOK_TOLERANCE_SECONDS="300"
# INVENTORY RESERVATIONS
INVENTORY_RESERVATION_TTL_MINUTES="15"
INVENTORY_MAX_ACTIVE_ORDERS_PER_USER="3"
INVENTORY_EXPIRY_BATCH_SIZE="100"
INVENTORY_MAX_ORDERS_PER_WINDOW="10"
INVENTORY_ORDER_RATE_WINDOW_MINUTES="1"
INVENTORY_TRANSACTION_MAX_ATTEMPTS="4"
INVENTORY_RECONCILIATION_BATCH_SIZE="250"

# TRANSACTIONAL OUTBOX WORKER (MySQL is the source of truth)
OUTBOX_BATCH_SIZE="50"
OUTBOX_POLL_INTERVAL_MS="1000"
OUTBOX_LEASE_SECONDS="60"
OUTBOX_MAX_ATTEMPTS="10"
OUTBOX_BACKOFF_BASE_MS="1000"
OUTBOX_BACKOFF_MAX_MS="300000"
OUTBOX_CONCURRENCY="5"
OUTBOX_SHUTDOWN_TIMEOUT_MS="30000"
OUTBOX_HEARTBEAT_TTL_SECONDS="15"
OUTBOX_DEAD_LETTER_CRITICAL_THRESHOLD="1"
# OUTBOX_REQUIRED_WORKER_VERSION="0.1.0"
# OUTBOX_REQUIRED_WORKER_ID_PREFIX="production-outbox:"

# EMAIL / SMS NOTIFICATIONS
# Default "log" never sends PII outside the app. Use webhook only with HTTPS + hostname allowlist.
NOTIFICATION_PROVIDER="log"
# NOTIFICATION_EMAIL_WEBHOOK_URL="https://notify.example.com/email"
# NOTIFICATION_SMS_WEBHOOK_URL="https://notify.example.com/sms"
# NOTIFICATION_ALLOWED_HOSTS="notify.example.com"
# NOTIFICATION_WEBHOOK_TOKEN="YOUR_NOTIFICATION_PROVIDER_TOKEN"

# ============================
# DEMO/SEED SAFETY (development/demo only)
# ============================
# DEMO_SEED_ENABLED="false"
# DEMO_SELLER_SETUP_ENABLED="false"
# DEMO_ADMIN_PASSWORD="YOUR_DEMO_PASSWORD"
# DEMO_USER_PASSWORD="YOUR_DEMO_PASSWORD"
# DEMO_SHIPPER_PASSWORD="YOUR_DEMO_PASSWORD"
# DEMO_SELLER_PASSWORD="YOUR_DEMO_PASSWORD"